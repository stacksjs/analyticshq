{
  // Self-contained: a node_modules app has no vendored storage/framework/core
  // to extend, and resolves @stacksjs/* from node_modules (they ship .d.ts) —
  // not from a core/*/src path map. skipLibCheck keeps typecheck on the app's
  // own code rather than the framework's shipped declarations.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      // @stacksjs/* resolve from node_modules. (The former @stacksjs/router pin to
      // the vendored core src was dropped 2026-07-27: node_modules router 0.70.190
      // ships the #1982 route-table share via Symbol.for, so the split-instance
      // 404 (#1975) no longer needs a single vendored copy.)
      "Actions/*": ["./app/Actions/*"],
      "Commands/*": ["./app/Commands/*"],
      "Jobs/*": ["./app/Jobs/*"],
      "Middleware/*": ["./app/Middleware/*"],
      "Models/*": ["./app/Models/*"],
      "Notifications/*": ["./app/Notifications/*"],
      "~/*": ["./*"],
      "@/*": ["./resources/*"]
    }
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "types/**/*.d.ts",
    "app/Models/**/*.ts",
    "app/Services/**/*.ts",
    "app/Support/**/*.ts"
  ],
  "exclude": [
    "cloud/**",
    "dist/**",
    "node_modules/**",
    "pantry/**",
    "storage/framework/**",
    "resources/assets/**"
  ]
}
