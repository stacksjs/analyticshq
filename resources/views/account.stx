<script server>
useSeoMeta({
  title: "Account - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Account page — reactive. Fetches the current user from /api/me in onMount and
// drives the view through signals (no imperative DOM). The pre-render guard below
// handles the no-token redirect before paint; onMount handles an invalid token.
const session = useStore('session') as SessionStore
const loaded: StxSignal<boolean> = state(false)
const name: StxSignal<string> = state('')
const email: StxSignal<string> = state('')
const since: StxSignal<string> = state('--')
const avatarUrl: StxSignal<string> = state('')
const initialCh: StxSignal<string> = state('')
const provider: StxSignal<string> = state('')
const pro: StxSignal<boolean> = state(false)

function initial(s: string | null | undefined): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}
function fmtDate(v: string | null | undefined): string {
  if (!v)
    return '--'
  const d = new Date(v)
  if (Number.isNaN(d.getTime()))
    return '--'
  return d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

function logout(): void {
  // Fire-and-forget: the server revokes the token, but the visitor should not wait on
  // it. signOut clears both stores, expires the cookie, and navigates.
  fetch('/logout', { method: 'POST', headers: session.authHeaders() }).catch(() => {})
  session.signOut()
}

onMount(() => {
  if (!session.isAuthed()) {
    window.location.replace('/login')
    return
  }
  fetch('/api/me', { headers: session.authHeaders() })
    .then((r: Response) => {
      if (r.status === 401) {
        // Stale token: clear everything rather than only the localStorage key, or the
        // cookie survives and the server keeps rendering a signed-in shell.
        session.signOut()
        return null
      }
      return r.json() as Promise<MeResponse>
    })
    .then((d: MeResponse | null) => {
      if (!d || !d.user)
        return
      const u: SessionUser = d.user
      name.set(u.name || 'Your account')
      email.set(u.email || '')
      since.set(fmtDate(u.created_at))
      if (u.avatar)
        avatarUrl.set(u.avatar)
      else
        initialCh.set(initial(u.name || u.email))
      if (u.provider)
        provider.set(u.provider)
      pro.set(d.pro === true)
      loaded.set(true)
    })
    .catch(() => {})
})
</script>

<meta name="stx-layout" content="app">

<style>
:root {
  --bg: #fbfbfc; --panel: #ffffff; --border: rgba(15,23,42,0.08);
  --text: #0b1220; --text-2: #4b5563; --text-3: #98a2b3; --accent: #059669;
  --sans: 'Geist', ui-sans-serif, system-ui, sans-serif; --mono: 'Geist Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #080b12; --panel: #0f131c; --border: rgba(148,163,184,0.12);
    --text: #f2f5f9; --text-2: #b0b9c8; --text-3: #667085; --accent: #34d399; }
}
:root[data-theme="dark"] { --bg: #080b12; --panel: #0f131c; --border: rgba(148,163,184,0.12);
  --text: #f2f5f9; --text-2: #b0b9c8; --text-3: #667085; --accent: #34d399; }
:root[data-theme="light"] { --bg: #fbfbfc; --panel: #ffffff; --border: rgba(15,23,42,0.08);
  --text: #0b1220; --text-2: #4b5563; --text-3: #98a2b3; --accent: #059669; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
.btn { border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease, background-color 0.15s ease; font-weight: 600; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn-ghost { border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.badge { border: 1px solid var(--border); border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-2); }
.badge-pro { border-color: var(--accent); color: var(--accent); }
.avatar { border-radius: 999px; object-fit: cover; background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
.row { border-top: 1px solid var(--border); }
.skeleton { background: color-mix(in srgb, var(--text-3) 20%, transparent); border-radius: 6px; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 0.9; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
</style>

<div class="min-h-[100dvh]">
  <header class="flex items-center justify-between mx-auto px-5 md:px-6 h-16 max-w-3xl">
    <a href="/" class="text-lg wordmark">analyticshq</a>
    <div class="flex gap-2.5 items-center">
      <StxLink to="/dashboard" class="px-3.5 py-2 text-sm btn btn-ghost">Dashboard</StxLink>
      <button type="button" @click="logout" class="px-3.5 py-2 text-sm btn btn-ghost">Log out</button>
    </div>
  </header>

  <main class="mx-auto px-5 py-8 md:px-6 max-w-3xl">
    <h1 class="mb-6 text-2xl wordmark">Account</h1>

    <section class="mb-5 p-6 card">
      <div class="flex gap-4 items-center">
        @if (avatarUrl())
          <img class="h-14 w-14 avatar" :src="avatarUrl()" alt="" width="56" height="56">
        @else
          <div class="grid place-items-center h-14 w-14 avatar" style="color: var(--accent); font-weight: 700; font-size: 1.25rem">{{ initialCh() }}</div>
        @endif
        <div class="min-w-0">
          @if (loaded())
            <div class="font-semibold text-lg">{{ name() }}</div>
          @else
            <div class="skeleton" style="width: 160px; height: 20px"></div>
          @endif
          <div class="mt-1.5 text-sm text-text-2">{{ email() }}</div>
        </div>
        @if (provider())
          <span class="ml-auto px-2.5 py-1 badge">{{ provider() }}</span>
        @endif
      </div>
    </section>

    <section class="mb-5 card">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="text-xs tracking-wide uppercase" style="color: var(--text-3); font-family: var(--mono)">Plan</div>
          <div class="mt-1 font-semibold text-base">
            {{ pro() ? 'Pro' : 'Free' }}
            @if (pro())
              <span class="ml-1 px-2 py-0.5 badge badge-pro">active</span>
            @endif
          </div>
        </div>
        @if (pro())
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-ghost">Manage plan</StxLink>
        @else
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-primary">Upgrade to Pro</StxLink>
        @endif
      </div>
      <div class="flex items-center justify-between px-6 py-4 row">
        <div>
          <div class="text-xs tracking-wide uppercase" style="color: var(--text-3); font-family: var(--mono)">Member since</div>
          <div class="mt-1 text-base text-text-2">{{ since() }}</div>
        </div>
        <StxLink to="/dashboard" class="px-4 py-2 text-sm btn btn-ghost">Open dashboard</StxLink>
      </div>
    </section>

    <p class="text-sm text-text-3">
      Signed in with a private token. <a class="text-accent" href="/">Back to site</a>
    </p>
  </main>
</div>

{{-- Pre-paint guard: bounce to /login before first paint when there is no token.

    This is one of the few places that legitimately touches localStorage directly.
    It runs before the signals runtime and the store bundle exist, so useStore is not
    available yet; ch.8.11 lists the pre-paint auth bounce as the documented exception,
    and `replace` is deliberate so Back cannot return here.

    It MUST decode, not just test for presence. The session store persists through
    useLocalStorage, which JSON.stringifies -- so a signed-out token is the literal
    two-character string "" , which is truthy. Testing the raw value would let a
    signed-out visitor straight through. --}}
<script>
;(function () {
  // useLocalStorage rather than a raw read: localStorage is on stx's prohibited list,
  // and the composable owns the JSON decode this guard MUST perform. The session store
  // persists through the same composable, so a signed-out token is the literal
  // two-character string "" -- testing the raw value would let a signed-out visitor
  // straight through.
  //
  // Reached through window.stx, not as a bare call: this is a plain script block, not
  // the client-script path that gets the auto-import preamble. The runtime tag is
  // synchronous and sits above this one, so window.stx is populated by the time this
  // runs. (The tag name is spelled without angle brackets deliberately -- stx counts
  // script tags across the whole file, and a literal one in a comment unbalances it.)
  //
  // Verified in a browser that a second instance on the same key is safe: two
  // useLocalStorage calls on 'token' both read the stored value and neither clobbers it.
  var token = window.stx.useLocalStorage('token', '')()
  if (!token)
    window.location.replace('/login')
})()
</script>
