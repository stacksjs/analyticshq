<script server>
useSeoMeta({
  title: "Account - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})

// Server-side auth gate. An stx server block cannot issue a 302, so instead of
// the removed client pre-paint guard, resolve the viewer from the HttpOnly
// `auth-token` cookie here and render a signed-out panel when it is absent or
// invalid. `authed` bridges to the client block (inlined as a literal) so the
// onMount /api/me fetch does not fire for a signed-out visitor.
let authed = false
const authToken = (typeof cookies !== 'undefined' ? cookies['auth-token'] : '') || ''
if (authToken) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    const viewer = await Auth.getUserFromToken(authToken)
    authed = !!viewer
  }
  catch { authed = false }
}

// The one value the client block reads. Declared rather than left to the implicit
// bridge, which scraped the same name but handed it over untyped.
defineClientPayload({ authed })
</script>

<script client>
// Account page - reactive. Fetches the current user from /api/me in onMount and
// drives the view through signals (no imperative DOM). Auth is the HttpOnly
// `auth-token` cookie: the SSR gate above renders a signed-out panel when it is
// absent, and this block only runs its data fetch when the server said `authed`.
const loaded: StxSignal<boolean> = state(false)
const name: StxSignal<string> = state('')
const email: StxSignal<string> = state('')
const since: StxSignal<string> = state('--')
const avatarUrl: StxSignal<string> = state('')
const initialCh: StxSignal<string> = state('')
const provider: StxSignal<string> = state('')
const pro: StxSignal<boolean> = state(false)
// A platform admin runs the install (app/Analytics/access.ts): every feature,
// no limits, never billed, so there is no plan to show and nothing to upgrade.
const admin: StxSignal<boolean> = state(false)

// --- Two-factor authentication ------------------------------------------
// TOTP enrollment over the same same-origin fetches this page already uses. The
// secret is generated and stashed server-side (/generate-two-factor-secret,
// delete-on-read); this page only shows it and sends back the 6-digit code,
// never the secret. State starts from /api/me and is flipped locally on
// enable/disable so there is no reload.
const twoFaEnabled: StxSignal<boolean> = state(false)
const twoFaBusy: StxSignal<boolean> = state(false)
const twoFaError: StxSignal<string> = state('')
// { secret, uri } while a setup is mid-flight, null otherwise. Its presence is
// what swaps the section from the pitch to the confirm form.
const twoFaSetup = state<{ secret: string, uri: string } | null>(null)

/** What /generate-two-factor-secret answers with (qr is ignored here). */
interface TwoFaSetupResponse { secret?: string, uri?: string }

async function startTwoFaSetup(): Promise<void> {
  if (twoFaBusy())
    return
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/generate-two-factor-secret', { method: 'POST', credentials: 'same-origin' })
    if (!res.ok) {
      twoFaError.set('Could not start setup. Please try again.')
      return
    }
    const d = await res.json().catch(() => ({})) as TwoFaSetupResponse
    if (!d.secret || !d.uri) {
      twoFaError.set('Could not start setup. Please try again.')
      return
    }
    twoFaSetup.set({ secret: d.secret, uri: d.uri })
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

function cancelTwoFaSetup(): void {
  twoFaSetup.set(null)
  twoFaError.set('')
}

async function confirmTwoFa(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (twoFaBusy())
    return
  const form = e.target as HTMLFormElement
  const code = (form.elements.namedItem('code') as HTMLInputElement)?.value?.trim() ?? ''
  // Checked here so a typo answers at once; the server re-verifies against the
  // stashed secret regardless.
  if (!/^\d{6}$/.test(code)) {
    twoFaError.set('Enter the 6-digit code from your authenticator app.')
    return
  }
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/enable-two-factor', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ code }),
    })
    if (!res.ok) {
      twoFaError.set('That code did not match. Check your authenticator app and try again.')
      return
    }
    twoFaEnabled.set(true)
    twoFaSetup.set(null)
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

async function disableTwoFa(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (twoFaBusy())
    return
  const form = e.target as HTMLFormElement
  const password = (form.elements.namedItem('password') as HTMLInputElement)?.value ?? ''
  if (!password) {
    twoFaError.set('Confirm your password to turn two-factor off.')
    return
  }
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/disable-two-factor', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ password }),
    })
    if (!res.ok) {
      twoFaError.set('Incorrect password. Two-factor is still on.')
      return
    }
    twoFaEnabled.set(false)
    form.reset()
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

function initial(s: string | null | undefined): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}
function fmtDate(v: string | null | undefined): string {
  if (!v)
    return '--'
  const d = new Date(v)
  if (Number.isNaN(d.getTime()))
    return '--'
  return d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

async function logout(): Promise<void> {
  // Ask the SERVER to clear the HttpOnly auth-token cookie (only it can) and
  // revoke the token, then navigate once that has settled so the Set-Cookie is
  // not raced by the next document request. A failure still sends the visitor to
  // /login rather than trapping them here.
  try {
    await fetch('/logout', { method: 'POST', credentials: 'same-origin' })
  }
  catch {}
  navigate('/login', { reload: true })
}

onMount(() => {
  // `authed` is bridged from the server gate. When false the signed-out panel is
  // what rendered, so there is nothing to fetch.
  if (!authed)
    return
  fetch('/api/me', { credentials: 'same-origin' })
    .then((r: Response) => {
      if (r.status === 401) {
        // The cookie is gone or expired: leave for /login (the server-cleared
        // cookie means the SSR gate will show the signed-out panel there too).
        navigate('/login', { reload: true })
        return null
      }
      return r.json() as Promise<MeResponse>
    })
    .then((d: MeResponse | null) => {
      if (!d || !d.user)
        return
      const u: SessionUser = d.user
      name.set(u.name || 'Your account')
      email.set(u.email || '')
      since.set(fmtDate(u.created_at))
      if (u.avatar)
        avatarUrl.set(u.avatar)
      else
        initialCh.set(initial(u.name || u.email))
      if (u.provider)
        provider.set(u.provider)
      pro.set(d.pro === true)
      admin.set(d.platformAdmin === true)
      twoFaEnabled.set(u.two_factor_enabled === true)
      loaded.set(true)
    })
    .catch(() => {})
})
</script>

@extends('app')

{{-- No <style> block, and no @push('styles'): rule 3 / §11.1. Tokens, body and
    .wordmark are a preflight in config/crosswind.ts; .card, .badge, .badge-pro,
    .avatar, .row and .skeleton are shortcuts there, and the two buttons this page
    spelled as `.btn .btn-primary` and `.btn .btn-ghost` are `btn-accent` and
    `btn-ghost` -- the same two the auth views and visitor.stx use, because measured
    declaration by declaration they were always the same two. --}}

@section('content')
<div class="min-h-[100dvh]">
  <header class="flex items-center justify-between mx-auto px-5 md:px-6 h-16 max-w-3xl">
    <StxLink to="/" class="text-lg wordmark">analyticshq</StxLink>
    <div class="flex gap-2.5 items-center">
      <ThemeToggle />
      @if (authed)
        <StxLink to="/dashboard" class="px-3.5 py-2 text-sm btn-ghost">Dashboard</StxLink>
        <button type="button" @click="logout" class="px-3.5 py-2 text-sm btn-ghost">Log out</button>
      @else
        <StxLink to="/login" class="px-3.5 py-2 text-sm btn-ghost">Sign in</StxLink>
      @endif
    </div>
  </header>

  @if (!authed)
    {{-- Signed-out gate. The SSR cookie read found no valid session, and a server
        block cannot 302, so render the sign-in panel in place of the account. --}}
    <div class="mx-auto px-5 py-16 md:px-6 max-w-3xl text-center">
      {{-- `bare` inside the page's own .card: this page is built on that
           class at its own radius, so the component supplies the layout and
           the card keeps supplying the surface. --}}
      <div class="mx-auto p-10 max-w-md card">
        <EmptyState
          variant="bare"
          title="Sign in to your account"
          description="Your account is private. Sign in to manage your plan and settings."
        >
          <StxLink to="/login" class="inline-block px-4 py-2 text-sm btn-accent">Sign in</StxLink>
        </EmptyState>
      </div>
    </div>
  @else
  {{-- A div rather than another main: the layout owns the single router container. Same classes. --}}
  <div class="mx-auto px-5 py-8 md:px-6 max-w-3xl">
    <h1 class="mb-6 text-2xl wordmark">Account</h1>

    <section class="mb-5 p-6 card">
      <div class="flex gap-4 items-center">
        <!--
          The initial sits underneath and the photo covers it, rather than the two
          being @if/@else on the URL. A URL existing is not the same as an image
          loading: the provider's avatar can 404 or 403 from its host, and
          branching on the URL alone left a broken one as an empty circle.
          `onerror` is the native attribute, not stx's `@error`, because stx wires
          25 event names and `error` is not among them -- an `@error` here would
          render as an inert attribute and never fire.
        -->
        <div class="relative shrink-0 h-14 w-14">
          <div class="grid place-items-center h-14 w-14 font-bold text-[1.25rem] text-[var(--accent-text)] avatar">{{ initialCh() }}</div>
          @if (avatarUrl())
            <img class="absolute inset-0 h-14 w-14 avatar" :src="avatarUrl()" alt="" width="56" height="56" onerror="this.hidden = true">
          @endif
        </div>
        <div class="min-w-0">
          @if (loaded())
            <div class="font-semibold text-lg">{{ name() }}</div>
          @else
            <div class="h-[20px] w-[160px] skeleton"></div>
          @endif
          <div class="mt-1.5 text-sm text-text-2">{{ email() }}</div>
        </div>
        @if (provider())
          <span class="ml-auto px-2.5 py-1 badge">{{ provider() }}</span>
        @endif
      </div>
    </section>

    <section class="mb-5 card">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="text-[var(--text-3)] text-xs tracking-wide uppercase [font-family:var(--mono)]">Plan</div>
          <div class="mt-1 font-semibold text-base">
            @if (admin())
              Admin
              <span class="ml-1 px-2 py-0.5 badge badge-pro">all features</span>
            @else
              {{ pro() ? 'Pro' : 'Free' }}
              @if (pro())
                <span class="ml-1 px-2 py-0.5 badge badge-pro">active</span>
              @endif
            @endif
          </div>
          @if (admin())
            <div class="mt-1 text-text-3 text-xs">This account runs the install: every site is open to it, and its own sites have every feature with no limits. Never billed.</div>
          @endif
        </div>
        @if (admin())
          <StxLink to="/dashboard" class="px-4 py-2 text-sm whitespace-nowrap btn-ghost">All sites</StxLink>
        @elseif (pro())
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn-ghost">Manage plan</StxLink>
        @else
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn-accent">Upgrade to Pro</StxLink>
        @endif
      </div>
      <div class="flex items-center justify-between row-rule px-6 py-4">
        <div>
          <div class="text-[var(--text-3)] text-xs tracking-wide uppercase [font-family:var(--mono)]">Member since</div>
          <div class="mt-1 text-base text-text-2">{{ since() }}</div>
        </div>
        <StxLink to="/dashboard" class="px-4 py-2 text-sm btn-ghost">Open dashboard</StxLink>
      </div>
    </section>

    <section class="mb-5 card">
      <div class="px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-[var(--text-3)] text-xs tracking-wide uppercase [font-family:var(--mono)]">Two-factor authentication</div>
            <div class="mt-1 font-semibold text-base">
              {{ twoFaEnabled() ? 'On' : 'Off' }}
              @if (twoFaEnabled())
                <span class="ml-1 px-2 py-0.5 badge badge-pro">active</span>
              @endif
            </div>
          </div>
          @if (!twoFaEnabled() && !twoFaSetup())
            <button @click="startTwoFaSetup" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" class="px-4 py-2 text-sm whitespace-nowrap btn-accent">{{ twoFaBusy() ? 'Starting...' : 'Set up' }}</button>
          @endif
        </div>

        @if (twoFaError())
          <div role="alert" class="mt-3 py-2 err notice-box">{{ twoFaError() }}</div>
        @endif

        {{-- Off, nothing in progress: the pitch. --}}
        @if (!twoFaEnabled() && !twoFaSetup())
          <p class="mt-3 text-sm text-text-2">Add a second step at sign-in so a stolen password alone cannot open your account. Works with any authenticator app (1Password, Google Authenticator, Authy).</p>
        @endif

        {{-- Setup mid-flight: show the secret and otpauth link, take the code.
             The secret is held server-side for 10 minutes; re-opening setup
             replaces it, so the code must come from the last secret shown. --}}
        @if (!twoFaEnabled() && twoFaSetup())
          <p class="mt-3 text-sm text-text-2">Add this secret to your authenticator app, then enter the 6-digit code it shows. The secret is held for 10 minutes.</p>
          <p class="mb-1 mt-3 text-[var(--text-3)] text-xs tracking-wide uppercase [font-family:var(--mono)]">Secret (enter manually)</p>
          <p class="px-3 py-2 break-all text-sm tracking-[0.08em] card mono">{{ twoFaSetup()?.secret }}</p>
          <p class="mt-2 text-sm text-text-3">On this device? <a :href="twoFaSetup()?.uri" class="text-accent">open in your authenticator app</a> instead of typing it.</p>
          <form @submit="confirmTwoFa" class="mt-4">
            <label for="twofa-code" class="block mb-1.5 font-medium text-text-2 text-xs">6-digit code</label>
            <input id="twofa-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required placeholder="000000" class="px-3.5 py-2.5 w-full text-sm field mono">
            <div class="flex gap-2.5 items-center mt-3">
              <button type="submit" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" class="px-4 py-2 text-sm btn-accent">{{ twoFaBusy() ? 'Confirming...' : 'Confirm and enable' }}</button>
              <button type="button" @click="cancelTwoFaSetup" :disabled="twoFaBusy()" class="px-4 py-2 font-semibold text-sm btn-ghost">Cancel</button>
            </div>
          </form>
        @endif

        {{-- Enabled: offer to turn off, password re-confirmed server-side. --}}
        @if (twoFaEnabled())
          <p class="mt-3 text-sm text-text-2">Sign-in needs your password plus a code from your authenticator app. Confirm your password to turn this off.</p>
          <form @submit="disableTwoFa" class="mt-3">
            <label for="twofa-off-password" class="block mb-1.5 font-medium text-text-2 text-xs">Password</label>
            <input id="twofa-off-password" name="password" type="password" autocomplete="current-password" required placeholder="Confirm your password" class="px-3.5 py-2.5 w-full text-sm field">
            <button type="submit" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" class="mt-3 px-4 py-2 text-sm btn-danger">{{ twoFaBusy() ? 'Turning off...' : 'Turn off two-factor' }}</button>
          </form>
        @endif
      </div>
    </section>

    <p class="text-sm text-text-3">
      Signed in with a private token. <StxLink class="text-accent" to="/">Back to site</StxLink>
    </p>
  </div>
  @endif
</div>
@endsection
