<script server>
useSeoMeta({
  canonical: 'https://analyticshq.org/features/metrics',
  title: "Pageviews and sessions - analyticshq",
  description: "Every hit counted once and exactly. Pageviews roll up into sessions with entry and exit paths, time on page, and bounce rate — no sampling, no estimates.",
})

// Drives BOTH the JSON-LD below and the visible nav, so the two cannot drift.
const crumbs = [
  { name: "Home", href: "/", url: "https://analyticshq.org/" },
  { name: "Features", href: "/features", url: "https://analyticshq.org/features", noRouter: true },
  { name: "Pageviews and sessions" },
]
</script>

@extends('marketing')

@push('scripts')
      @structuredData({
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
      })
@endpush

@section('content')
      <nav class="shell subnav" aria-label="Breadcrumb">
        @foreach (crumbs as c)
          @if (c.href)
            <a href="{{ c.href }}"{{ c.noRouter ? ' data-no-router' : '' }}>{{ c.name }}</a><span class="sep" aria-hidden="true">/</span>
          @else
            <span aria-current="page">{{ c.name }}</span>
          @endif
        @endforeach
      </nav>

      <section class="feat-hero shell">
