<script server>
// Signed in already? Then this page offers the dashboard rather than a form
// (see the @auth block below). stx's @auth reads `auth`; the shared helper
// resolves it from the session cookie (app/Support/session.ts).
import { sessionFrom } from '../../app/Support/session'

const auth = await sessionFrom(typeof cookies !== 'undefined' ? cookies : {})

useSeoMeta({
  title: "Create your account - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Uniform HQ auth. RegisterAction sets the HttpOnly `auth-token` cookie in its
// own response, so a full navigation to /dashboard lets the SSR page read the
// fresh cookie. No token is kept in JS - the cookie IS the session. Uncontrolled
// inputs read from the submit event; error/loading are signals.
const error: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  const field = (n: string): string => (form.elements.namedItem(n) as HTMLInputElement).value
  if (field('password').length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const email = field('email')
    const password = field('password')
    const res = await fetch('/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ name: field('name'), email, password }),
    })
    const data: AuthResponse = await res.json().catch(() => ({}))
    if (!res.ok) {
      error.set(data.message || 'Could not create the account.')
      return
    }

    // The auth-token cookie the SERVER needs comes with the register response
    // itself (RegisterAction sets it, baseline 7-day tier). A full navigation
    // then lands on the owner-scoped dashboard rather than the signed-out gate.
    window.location.assign('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>



@extends('auth')

@section('content')
@auth
<div class="max-w-sm w-full text-center" data-signed-in>
  <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
  <p class="mt-6 text-sm text-text-2">You are signed in as <span class="font-medium text-text">{{ auth.user?.email }}</span>.</p>
  <div class="flex flex-col gap-2.5 mt-6">
    <StxLink to="/dashboard" class="py-2.5 w-full font-semibold text-sm btn">Go to your dashboard</StxLink>
    <StxLink to="/account" class="py-2.5 w-full font-medium text-sm oauth-btn">Account</StxLink>
  </div>
  <p class="mt-5 text-text-3 text-xs">To create an account with a different account, log out from your account page first.</p>
</div>
@else
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
    <p class="mt-2 text-sm text-text-3">Create your account</p>
  </div>

  <form @submit="handleSubmit" class="space-y-4">
    @if (error())
      <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
    @endif

    <div>
      <label for="register-name" class="block mb-1.5 font-medium text-text-2 text-xs">Name</label>
      <input id="register-name" name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" class="px-3.5 py-2.5 w-full text-sm field">
    </div>
    <div>
      <label for="register-email" class="block mb-1.5 font-medium text-text-2 text-xs">Email</label>
      <input id="register-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
    </div>
    <div>
      <label for="register-password" class="block mb-1.5 font-medium text-text-2 text-xs">Password</label>
      <input id="register-password" name="password" type="password" required autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
    </div>

    <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
      {{ loading() ? 'Creating account…' : 'Create account' }}
    </button>
  </form>

  <div class="my-5 divider">or</div>

  <div class="space-y-2.5">
    <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
      Continue with GitHub
    </a>
    <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
      Continue with Google
    </a>
  </div>

  <p class="mt-6 text-center text-sm text-text-3">
    Already have an account?
    <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
  </p>
</div>
@endauth
@endsection
