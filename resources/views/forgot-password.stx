<script server>
useSeoMeta({
  title: "Reset your password - analyticshq",
  // Auth flow, same as login/register: never advertise these as indexable.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Step 1 of password reset: ask for the address, POST /password/forgot, and let the
// mailer take it from there.
const error: StxSignal<string> = state('')
const sent: StxSignal<boolean> = state(false)
const loading: StxSignal<boolean> = state(false)

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    })

    // ONLY 429 IS SURFACED. Every other outcome renders the same neutral message, and
    // that is a security decision, not laziness.
    //
    // SendPasswordResetEmailAction is an account-existence oracle. Measured against the
    // running API:
    //
    //   known address    -> 500 {"message":"Failed to send password reset email..."}
    //   unknown address  -> 404 {"message":"No account found with this email address."}
    //
    // Distinguishable by status AND by message, on an unauthenticated endpoint, for any
    // address a visitor cares to type. (The 500 is this environment's broken mailer; a
    // healthy one answers 200. Either way the two branches differ.)
    //
    // My first version of this handler branched on `res.status >= 500` to show "we could
    // not send the email" -- which quietly reintroduced the leak whenever mail was
    // degraded, because unknown addresses never reach the mailer and so never 500. So
    // the failure case is folded into the neutral message too. An operator still sees
    // the failure in the server log; a stranger learns nothing either way.
    //
    // 429 stays visible because a rate limit is a fact about the REQUESTER, not about
    // whether some third party has an account, and swallowing it would leave someone
    // waiting on an email that was never queued.
    //
    // The sibling action, PasswordResetAction, explicitly avoids this same leak in its
    // own error path -- so the framework already agrees it matters and just missed it
    // here. Filed upstream.
    if (res.status === 429) {
      error.set('Too many attempts. Wait a minute and try again.')
      return
    }
    sent.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('auth')

@section('content')
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
    <p class="mt-2 text-sm text-text-3">Reset your password</p>
  </div>

  @if (sent())
    <div class="px-3 py-3 text-sm rounded-lg ok">
      If that address has an account, a reset link is on its way. The link is good for
      60 minutes.
    </div>
    <p class="mt-6 text-center text-sm text-text-3">
      <StxLink to="/login" class="font-medium text-accent">← Back to sign in</StxLink>
    </p>
  @else
    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
      @endif

      <div>
        <label class="block mb-1.5 font-medium text-text-2 text-xs">Email</label>
        <input name="email" type="email" required autofocus autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
        {{ loading() ? 'Sending…' : 'Send reset link' }}
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-text-3">
      Remembered it?
      <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
    </p>
  @endif
</div>
@endsection
