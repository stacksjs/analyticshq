<script server>
useSeoMeta({
  title: "Add a site - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})

// Server-side auth gate. An stx server block cannot 302, so resolve the viewer
// from the HttpOnly auth-token cookie and render a signed-out panel when absent,
// in place of the removed client pre-paint bounce. `authed` bridges to the client.
let authed = false
const authToken = (typeof cookies !== 'undefined' ? cookies['auth-token'] : '') || ''
if (authToken) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    const viewer = await Auth.getUserFromToken(authToken)
    authed = !!viewer
  }
  catch { authed = false }
}
</script>

<script client>
// Add-site screen. Creates an owned site via POST /api/sites, then drops into that
// site's dashboard, where the server-rendered setup panel shows the install snippet.
// error/loading are signals; the name/domain inputs are uncontrolled (read at submit).
// Auth is the HttpOnly auth-token cookie; the SSR gate above walls off signed-out
// visitors, and the POST below is a same-origin credentialed fetch.
interface CreatedSite { id: string }
interface CreateSiteResponse { site?: CreatedSite, error?: string }

const error: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim()
  if (!name) {
    error.set('Give your site a name.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const domain = (form.elements.namedItem('domain') as HTMLInputElement).value.trim()
    const res = await fetch('/api/sites', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, domain }),
    })
    const data: CreateSiteResponse = await res.json().catch(() => ({}))
    if (res.status === 401) {
      // The session cookie is gone or expired: leave for /login (a full navigation
      // so the SSR gate re-resolves there too).
      window.location.assign('/login')
      return
    }
    if (!res.ok || !data.site || !data.site.id) {
      error.set(data.error || 'Could not create the site.')
      loading.set(false)
      return
    }
    // Straight into the new site's dashboard (which shows the install snippet).
    navigate(`/dashboard?site=${encodeURIComponent(data.site.id)}`)
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>



@extends('auth')

@section('content')
<div class="max-w-md w-full">
  <div class="mb-8 text-center">
    <StxLink to="/dashboard" class="text-2xl wordmark">analyticshq</StxLink>
  </div>

  @if (!authed)
    {{-- Signed-out gate: the SSR cookie read found no valid session. --}}
    <div class="text-center">
      <h1 class="mb-2 font-semibold text-xl tracking-tight">Sign in to add a site</h1>
      <p class="mb-6 text-sm text-text-3">Adding a site needs an account. Sign in to continue.</p>
      <StxLink to="/login" class="inline-block px-4 py-2.5 font-semibold text-sm btn">Sign in</StxLink>
    </div>
  @else
  <div class="mb-8 text-center">
    <h1 class="font-semibold text-xl tracking-tight">Add a site</h1>
    <p class="mt-2 text-sm text-text-3">Each site gets its own tracking id and dashboard.</p>
  </div>

  <form @submit="handleSubmit" class="space-y-4">
    @if (error())
      <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
    @endif

    <div>
      <label for="site-name" class="block mb-1.5 font-medium text-text-2 text-xs">Site name</label>
      <input id="site-name" name="name" type="text" required autofocus placeholder="My Blog" class="px-3.5 py-2.5 w-full text-sm field">
    </div>
    <div>
      <label for="site-domain" class="block mb-1.5 font-medium text-text-2 text-xs">Domain <span class="text-text-3">(optional)</span></label>
      <input id="site-domain" name="domain" type="text" placeholder="example.com" class="px-3.5 py-2.5 w-full text-sm field">
    </div>

    <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
      {{ loading() ? 'Creating…' : 'Create site' }}
    </button>
  </form>

  <p class="mt-6 text-center text-sm text-text-3">
    <StxLink to="/dashboard" class="font-medium text-accent">← Back to dashboard</StxLink>
  </p>
  @endif
</div>
@endsection
