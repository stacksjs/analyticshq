<script server>
useSeoMeta({
  title: "Add a site - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Add-site screen. Creates an owned site via POST /api/sites, then drops into that
// site's dashboard, where the server-rendered setup panel shows the install snippet.
// error/loading are signals; the name/domain inputs are uncontrolled (read at submit).
interface CreatedSite { id: string }
interface CreateSiteResponse { site?: CreatedSite, error?: string }

const session = useStore('session') as SessionStore
const error: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)

// Pre-paint auth bounce. `replace` is deliberate so the signed-out visitor cannot land
// back here with Back. This used to be a native window.location.replace on the grounds
// that the router is not up yet -- but that is exactly what navigate() already does
// when window.stxRouter is absent (signals.js:1005-1015), so the native call bought
// nothing and only opted out of the upgrade if the ordering ever changes.
// The cookie mirror that used to live here is gone, and so is the session store's
// effect that replaced it (#33) -- LoginAction sets the auth cookie server-side, and
// it is HttpOnly, so no page and no store can or needs to write it.
if (!session.isAuthed())
  navigate('/login', { replace: true })

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim()
  if (!name) {
    error.set('Give your site a name.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const domain = (form.elements.namedItem('domain') as HTMLInputElement).value.trim()
    const res = await session.authFetch('/api/sites', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, domain }),
    })
    const data: CreateSiteResponse = await res.json().catch(() => ({}))
    if (res.status === 401) {
      // Reaching here now means the renewal did not rescue it -- authFetch has already
      // tried, and already signed the visitor out if the refresh token was refused. So
      // this covers the remaining case: no refresh token at all. Clear the stale access
      // token so the guard above does not bounce this visitor straight back here.
      session.signOut()
      return
    }
    if (!res.ok || !data.site || !data.site.id) {
      error.set(data.error || 'Could not create the site.')
      loading.set(false)
      return
    }
    // Straight into the new site's dashboard (which shows the install snippet).
    navigate(`/dashboard?site=${encodeURIComponent(data.site.id)}`)
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>



@extends('auth')

@section('content')
<div class="max-w-md w-full">
  <div class="mb-8 text-center">
    <StxLink to="/dashboard" class="text-2xl wordmark">analyticshq</StxLink>
  </div>

  <div class="mb-8 text-center">
    <h1 class="font-semibold text-xl tracking-tight">Add a site</h1>
    <p class="mt-2 text-sm text-text-3">Each site gets its own tracking id and dashboard.</p>
  </div>

  <form @submit="handleSubmit" class="space-y-4">
    @if (error())
      <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
    @endif

    <div>
      <label class="block mb-1.5 font-medium text-text-2 text-xs">Site name</label>
      <input name="name" type="text" required autofocus placeholder="My Blog" class="px-3.5 py-2.5 w-full text-sm field">
    </div>
    <div>
      <label class="block mb-1.5 font-medium text-text-2 text-xs">Domain <span class="text-text-3">(optional)</span></label>
      <input name="domain" type="text" placeholder="example.com" class="px-3.5 py-2.5 w-full text-sm field">
    </div>

    <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
      {{ loading() ? 'Creating…' : 'Create site' }}
    </button>
  </form>

  <p class="mt-6 text-center text-sm text-text-3">
    <StxLink to="/dashboard" class="font-medium text-accent">← Back to dashboard</StxLink>
  </p>
</div>
@endsection
