<script server>
const appName = 'analyticshq'

const meta = {
  canonical: 'https://analyticshq.org/compare',
  title: 'analyticshq vs the alternatives - every option compared',
  description: 'How analyticshq compares to Google Analytics, Plausible, Fathom, Simple Analytics, Umami, Matomo, Cloudflare Web Analytics, and Mixpanel. Cookieless, exact, and privacy-first by design.',
}

const alternatives = [
  { slug: 'google-analytics', name: 'vs Google Analytics', desc: 'The GA4 alternative with no cookie banner, no sampling, and one-click import.' },
  { slug: 'plausible', name: 'vs Plausible', desc: 'Two cookieless tools. How the reports, pricing, and ownership differ.' },
  { slug: 'fathom', name: 'vs Fathom', desc: 'Both privacy-first. Where analyticshq goes further on data ownership.' },
  { slug: 'simple-analytics', name: 'vs Simple Analytics', desc: 'Aggregate-only analytics, compared feature for feature.' },
  { slug: 'umami', name: 'vs Umami', desc: 'Open-source analytics, and where the privacy lines are drawn.' },
  { slug: 'matomo', name: 'vs Matomo', desc: 'The lighter, cookieless alternative to the classic GA replacement.' },
  { slug: 'cloudflare', name: 'vs Cloudflare', desc: 'Cookieless like Cloudflare, but with events and data you own.' },
  { slug: 'mixpanel', name: 'vs Mixpanel', desc: 'Privacy-first web analytics next to heavy product analytics.' },
]

const pillars = [
  { h: 'Cookieless by design', b: 'No cookies, no local storage, no consent banner, on every one of these comparisons. Nothing is written to a visitor’s device.' },
  { h: 'You own the data', b: 'Every event lands in your own PostgreSQL database. It is never sampled, sold, or shared with an ad network.' },
  { h: 'Exact, not estimated', b: 'Every event is counted. No sampling, no thresholds, no “data not available” once your traffic grows.' },
]

useSeoMeta(meta)

// Drives BOTH the JSON-LD below and the visible nav, so the two cannot drift.
const crumbs = [
  { name: "Home", href: "/", url: "https://analyticshq.org/" },
  { name: "Compare" },
]
</script>

@extends('marketing')


@push('scripts')
      @structuredData({
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
      })
@endpush

@section('content')
      <nav class="shell subnav" aria-label="Breadcrumb">
        @foreach (crumbs as c)
          @if (c.href)
            <a href="{{ c.href }}"{{ c.noRouter ? ' data-no-router' : '' }}>{{ c.name }}</a><span class="sep" aria-hidden="true">/</span>
          @else
            <span aria-current="page">{{ c.name }}</span>
          @endif
        @endforeach
      </nav>

      <section class="feat-hero shell">
        <span class="kicker">Compare</span>
        <h1>Every alternative, compared honestly.</h1>
        <p>Whichever analytics tool you are weighing, the same three things hold: no cookies, exact numbers, and data that stays yours. Pick a comparison to see it point for point.</p>
        <div class="hero-actions">
          <a class="btn primary" href="/#install">Get your script tag</a>
          <StxLink to="/features/privacy" class="btn ghost">How the privacy works</StxLink>
        </div>
      </section>

      <section class="reveal section shell" aria-labelledby="alts-heading">
        <div class="section-head">
          <h2 id="alts-heading" class="section-title">Pick a comparison</h2>
        </div>
        <div class="related">
          @foreach (alternatives as a)
            <StxLink to="/compare/{{ a.slug }}">
              <div class="r-name">{{ a.name }}</div>
              <div class="r-desc">{{ a.desc }}</div>
            </StxLink>
          @endforeach
          <StxLink to="/features/privacy">
            <div class="r-name">Why privacy-first?</div>
            <div class="r-desc">The cookieless model behind every one of these comparisons.</div>
          </StxLink>
        </div>
      </section>

      <section class="reveal section shell" aria-labelledby="pillars-heading">
        <div class="section-head">
          <h2 id="pillars-heading" class="section-title">What stays true across every comparison</h2>
        </div>
        <div class="chips">
          @foreach (pillars as p)
            <div class="chip">
              <h3>{{ p.h }}</h3>
              <p>{{ p.b }}</p>
            </div>
          @endforeach
        </div>
      </section>

      <section class="reveal section shell" aria-label="Get started">
        <div class="cta-band">
          <h2>Your numbers. Your visitors' privacy. Both intact.</h2>
          <div class="cta-actions">
            <a class="btn primary" href="/#install">Get your script tag</a>
            <StxLink to="/dashboard" class="btn ghost">See a live dashboard</StxLink>
          </div>
        </div>
      </section>
@endsection
