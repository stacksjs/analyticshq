<script server>
// Signed in already? Then this page offers the dashboard rather than a form
// (see the @auth block below). stx's @auth reads `auth`; the shared helper
// resolves it from the session cookie (app/Support/session.ts).
import { sessionFrom } from '../../app/Support/session'

const auth = await sessionFrom(typeof cookies !== 'undefined' ? cookies : {})

useSeoMeta({
  title: "Sign in - analyticshq",
  // Auth-walled. Without this these pages were advertised as indexable while
  // shipping the shell default title.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Uniform HQ auth. LoginAction sets the HttpOnly `auth-token` cookie in its own
// response; a full navigation to /dashboard then lets the SSR page read that
// fresh cookie. No token is kept in JS - the cookie IS the session - so there is
// no store here. Uncontrolled inputs read from the submit event; the signals
// below drive error/loading and the 2FA second step.
const error: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)
// Social sign-in failures come back as ?error= from the OAuth callback redirect.
const oauthError: StxSignal<string> = state('')
// Two-factor second step: shown only when an account has 2FA enabled and
// LoginAction answers `requires_two_factor`. Dormant until enrollment exists,
// but wired so a 2FA account can complete sign-in instead of locking out.
const twoFactor: StxSignal<boolean> = state(false)
const challengeToken: StxSignal<string> = state('')
// The "remember me" choice, captured at step 1 so the 2FA step (a separate
// request) issues the same session tier the user picked.
const rememberChoice: StxSignal<boolean> = state(false)

onMount(() => {
  const msg = useSearchParams().get('error')
  if (msg)
    oauthError.set(msg)
})

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  loading.set(true)
  error.set('')
  try {
    const email = (form.elements.namedItem('email') as HTMLInputElement).value
    const password = (form.elements.namedItem('password') as HTMLInputElement).value
    const remember = (form.elements.namedItem('remember') as HTMLInputElement)?.checked === true
    rememberChoice.set(remember)
    const res = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ email, password, remember }),
    })
    const data: AuthResponse = await res.json().catch(() => ({}))
    // 2FA-enabled account: no session yet, only a challenge. Swap to the code step.
    if (data.requires_two_factor) {
      challengeToken.set(data.challenge_token || '')
      twoFactor.set(true)
      return
    }
    if (!res.ok) {
      error.set(data.message || 'Invalid email or password.')
      return
    }
    // The auth-token cookie the SERVER reads to render the owner-scoped dashboard
    // arrives with THIS response (LoginAction sets it), so a full navigation lands
    // on data rather than the signed-out gate.
    window.location.assign('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}

async function handleVerify(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  loading.set(true)
  error.set('')
  try {
    const code = (form.elements.namedItem('code') as HTMLInputElement).value.trim()
    const res = await fetch('/verify-two-factor-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ challenge_token: challengeToken(), code, remember: rememberChoice() }),
    })
    const data: AuthResponse = await res.json().catch(() => ({}))
    if (res.ok && (data.token || data.access_token)) {
      window.location.assign('/dashboard')
      return
    }
    // Challenge tokens are single-use; a failed code sends the user back to step 1.
    error.set(data.message || 'Invalid code. Please sign in again.')
    twoFactor.set(false)
    challengeToken.set('')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>



@extends('auth')

@section('content')
@auth
<div class="max-w-sm w-full text-center" data-signed-in>
  <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
  <p class="mt-6 text-sm text-text-2">You are signed in as <span class="font-medium text-text">{{ auth.user.email }}</span>.</p>
  <div class="flex flex-col gap-2.5 mt-6">
    <StxLink to="/dashboard" class="py-2.5 w-full font-semibold text-sm btn">Go to your dashboard</StxLink>
    <StxLink to="/account" class="py-2.5 w-full font-medium text-sm oauth-btn">Account</StxLink>
  </div>
  <p class="mt-5 text-text-3 text-xs">To sign in with a different account, log out from your account page first.</p>
</div>
@else
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
    <p class="mt-2 text-sm text-text-3">Sign in to your account</p>
  </div>

  @if (error())
    <div class="mb-4 px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
  @endif

  {{-- Step 1: credentials. Hidden once a 2FA challenge is in flight. --}}
  <form @submit="handleSubmit" :show="!twoFactor()" class="space-y-4">
    <div>
      <label for="login-email" class="block mb-1.5 font-medium text-text-2 text-xs">Email</label>
      <input id="login-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
    </div>
    <div>
      <div class="flex items-baseline justify-between mb-1.5">
        <label for="login-password" class="font-medium text-text-2 text-xs">Password</label>
        <StxLink to="/forgot-password" class="text-text-3 text-xs hover:text-accent">Forgot?</StxLink>
      </div>
      <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="px-3.5 py-2.5 w-full text-sm field">
    </div>

    <label for="login-remember" class="flex gap-2 items-center text-sm text-text-3 cursor-pointer select-none">
      <input id="login-remember" name="remember" type="checkbox" class="h-4 w-4" style="accent-color: var(--accent)">
      <span>Keep me signed in for 30 days</span>
    </label>

    <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
      {{ loading() ? 'Signing in…' : 'Sign in' }}
    </button>
  </form>

  {{-- Step 2: the 6-digit TOTP code, shown only when step 1 returns a challenge. --}}
  <form @submit="handleVerify" :show="twoFactor()" style="display:none" class="space-y-4">
    <div>
      <label for="login-code" class="block mb-1.5 font-medium text-text-2 text-xs">Authentication code</label>
      <input id="login-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" class="px-3.5 py-2.5 w-full text-sm field">
      <p class="mt-1.5 text-text-3 text-xs">Enter the 6-digit code from your authenticator app.</p>
    </div>
    <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
      {{ loading() ? 'Verifying…' : 'Verify and sign in' }}
    </button>
  </form>

  <div :show="!twoFactor()">
    @if (oauthError())
      <div class="mt-4 px-3 py-2 text-sm rounded-lg err">{{ oauthError() }}</div>
    @endif

    <div class="my-5 divider">or</div>

    <div class="space-y-2.5">
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
    </div>

    <p class="mt-6 text-center text-sm text-text-3">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>
@endauth
@endsection
