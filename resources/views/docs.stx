{{-- NOTE ON WHETHER THIS FILE IS LIVE.

    In dev it is not: scripts/dev.ts documents that views.js proxies /docs and /docs/*
    unconditionally to the BunPress site on :3006, so this template is unreachable and
    http://localhost:3000/docs serves "Stacks Documentation" instead of the title below.

    It is kept, and migrated onto the layout, because `buddy build` enumerates
    resources/views via pagesDir, so a static deployment can still emit this page --
    and a deployment without the proxy would then serve it. Deleting real content on
    that ambiguity would be the wrong way to resolve it. Which of the two /docs should
    win in production is an open product question, not a template question. --}}

<script server>
useSeoMeta({
  canonical: 'https://analyticshq.org/docs',
  title: 'Docs - analyticshq',
  description: 'Ship analyticshq in one line: a first-party script under 2 KB, a one-function events API, and a read API for your numbers. No cookies, no consent banner, and no SDK to learn.',
})
</script>

@extends('marketing')

@section('content')
      <nav class="shell subnav" aria-label="Breadcrumb">
        <StxLink to="/">Home</StxLink><span class="sep">/</span>
        <span>Docs</span>
      </nav>

      <section class="feat-hero shell">
        <span class="kicker">Docs</span>
        <h1>Ship analyticshq in one line.</h1>
        <p>One first-party script under 2 KB, a tiny client call for custom events, and a read API for your numbers. No cookies, no consent banner, and no SDK to learn.</p>
        <div class="hero-actions">
          <StxLink class="btn primary" to="/register">Get your site ID</StxLink>
          <a class="btn ghost" href="https://github.com/stacksjs/analyticshq" data-no-router>View on GitHub</a>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Install the script">
        <div class="section-head">
          <h2 class="section-title">Install the script</h2>
          <p class="section-intro">Add one tag to your site head with your site ID. It loads deferred and first-party, and starts counting page views right away, including client-side route changes in single-page apps.</p>
        </div>
        <div class="code" style="max-width: 680px">
          <div class="code-bar"><span class="chart-cap">Add to every page, once</span></div>
          <pre class="code-body"><code>&lt;script defer
  src="https://analyticshq.org/script.js"
  data-site="YOUR_SITE_ID"&gt;&lt;/script&gt;</code></pre>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Track custom events">
        <div class="section-head">
          <h2 class="section-title">Track custom events</h2>
          <p class="section-intro">Once the script has loaded it puts an analyticshq() function on the page. Call it on any event that matters, with optional properties, to record a conversion beside your traffic.</p>
        </div>
        <div class="code" style="max-width: 680px">
          <div class="code-bar"><span class="chart-cap">On the event that matters</span></div>
          <pre class="code-body"><code>// e.g. right after a successful signup
analyticshq('signup', {
  plan: 'pro',
  value: 19,
})</code></pre>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Read your numbers with the API">
        <div class="section-head">
          <h2 class="section-title">Read your numbers with the API</h2>
          <p class="section-intro">Every figure on the dashboard is available over a small read API, scoped to your site ID and an optional date range. Wire it into a status board, a scheduled report, or your own UI.</p>
        </div>
        <div class="code" style="max-width: 680px">
          <div class="code-bar"><span class="chart-cap">GET /api/sites/{siteId}/*</span></div>
          <pre class="code-body"><code>GET /api/sites/{siteId}/stats        // visitors, views, sessions
GET /api/sites/{siteId}/timeseries   // views per day
GET /api/sites/{siteId}/pages        // top pages
GET /api/sites/{siteId}/referrers    // top sources

// example
fetch('https://analyticshq.org/api/sites/demo/stats?from=2026-07-01&amp;to=2026-07-10')
  .then(r =&gt; r.json())
// { "views": 8, "visitors": 4, "sessions": 4 }</code></pre>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Own your data">
        <div class="section-head">
          <h2 class="section-title">Own your data, self-host if you want</h2>
          <p class="section-intro">Every event lands in your own PostgreSQL database, so the numbers never leave your infrastructure and there is no third party to trust. The whole stack is open source.</p>
        </div>
        <div class="hero-actions">
          <a class="btn ghost" href="https://github.com/stacksjs/analyticshq" data-no-router>Read the source on GitHub</a>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Get started">
        <div class="cta-band">
          <h2>Start counting visitors, privately.</h2>
          <p>Add the script, watch the dashboard fill in. No cookie banner required.</p>
          <div class="cta-actions">
            <StxLink class="btn primary" to="/register">Get your site ID</StxLink>
            <StxLink class="btn ghost" to="/dashboard">See a live dashboard</StxLink>
          </div>
        </div>
      </section>
@endsection
