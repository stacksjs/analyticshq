<script server>
useSeoMeta({
  title: "Choose a new password - analyticshq",
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Step 2 of password reset. The emailed link carries the token and address as query
// params -- see config/auth.ts passwordReset.url, which points here rather than at the
// framework default /password/reset/{token} (that path collides with the POST endpoint
// of the same name).
//
// The token is checked BEFORE the form is offered. Letting someone pick and confirm a
// new password only to be told the link expired is a bad trade for one request.
const error: StxSignal<string> = state('')
const done: StxSignal<boolean> = state(false)
const loading: StxSignal<boolean> = state(false)
// 'checking' until verify-token answers, then 'valid' or 'invalid'.
const linkState: StxSignal<string> = state('checking')

const token: StxSignal<string> = state('')
const email: StxSignal<string> = state('')

onMount(() => {
  const params = useSearchParams()
  const t = params.get('token') || ''
  const e = params.get('email') || ''
  token.set(t)
  email.set(e)

  if (!t || !e) {
    linkState.set('invalid')
    return
  }

  fetch('/password/verify-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ token: t, email: e }),
  })
    .then((r: Response) => { linkState.set(r.ok ? 'valid' : 'invalid') })
    // A network failure is not an invalid token. Let them try to submit rather than
    // dead-ending on a message that blames their link for our connectivity.
    .catch(() => { linkState.set('valid') })
})

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target as HTMLFormElement
  const password = (form.elements.namedItem('password') as HTMLInputElement).value
  const confirmation = (form.elements.namedItem('password_confirmation') as HTMLInputElement).value

  // Checked here as well as server-side so the round trip is not spent on something
  // the browser already knows. PasswordResetAction enforces both independently.
  if (password.length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  if (password !== confirmation) {
    error.set('Those passwords do not match.')
    return
  }

  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        token: token(),
        email: email(),
        password,
        password_confirmation: confirmation,
      }),
    })
    if (res.ok) {
      // Deliberately NOT signing them in here. PasswordResetAction returns a success
      // message, not a token pack, and minting a session from a reset flow is a
      // decision worth making explicitly rather than inheriting.
      done.set(true)
      return
    }
    const data = await res.json().catch(() => ({})) as { message?: string }
    error.set(data.message || 'That reset link is no longer valid. Request a new one.')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('auth')

@section('content')
<div class="max-w-sm w-full">
  <div class="mb-8 text-center">
    <StxLink to="/" class="text-2xl wordmark">analyticshq</StxLink>
    <p class="mt-2 text-sm text-text-3">Choose a new password</p>
  </div>

  @if (done())
    <div class="px-3 py-3 text-sm rounded-lg ok">
      Your password has been changed. You can sign in with it now.
    </div>
    <p class="mt-6 text-center text-sm text-text-3">
      <StxLink to="/login" class="font-medium text-accent">Go to sign in →</StxLink>
    </p>
  @elseif (linkState() === 'checking')
    <p class="text-center text-sm text-text-3">Checking your link…</p>
  @elseif (linkState() === 'invalid')
    <div class="px-3 py-3 text-sm rounded-lg err">
      This reset link is invalid or has expired. Reset links are good for 60 minutes.
    </div>
    <p class="mt-6 text-center text-sm text-text-3">
      <StxLink to="/forgot-password" class="font-medium text-accent">Request a new one</StxLink>
    </p>
  @else
    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
      @endif

      <div>
        <label class="block mb-1.5 font-medium text-text-2 text-xs">New password</label>
        <input name="password" type="password" required autofocus autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label class="block mb-1.5 font-medium text-text-2 text-xs">Confirm password</label>
        <input name="password_confirmation" type="password" required autocomplete="new-password" placeholder="••••••••" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
        {{ loading() ? 'Saving…' : 'Change password' }}
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-text-3">
      <StxLink to="/login" class="font-medium text-accent">← Back to sign in</StxLink>
    </p>
  @endif
</div>
@endsection
