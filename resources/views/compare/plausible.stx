<script server>
import { competitors, crumbsFor } from '../../data/competitors'

const c = competitors.plausible
const crumbs = crumbsFor(c)

useSeoMeta(c.meta)
</script>

@extends('marketing')

@push('scripts')
      @structuredData({
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, name: crumb.name, item: crumb.url })),
      })
@endpush

@section('content')
      @include('compare-page', { c, crumbs })
@endsection
