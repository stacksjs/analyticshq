<script server>
useSeoMeta({
  canonical: 'https://analyticshq.org/pricing',
  title: "Pricing - analyticshq",
  description: "Simple, honest pricing for privacy-first web analytics. Start free with 10k events a month, upgrade to Pro for unlimited sites and events, or self-host for free forever.",
})

// Drives BOTH the JSON-LD below and the visible nav, so the two cannot drift.
const crumbs = [
  { name: "Home", href: "/", url: "https://analyticshq.org/" },
  { name: "Pricing" },
]
</script>

<script client>
// Pricing / upgrade via stx client directives. Interval + state are signals; the
// Upgrade button starts a Stripe Checkout on Stripe's own origin.
type BillingInterval = 'monthly' | 'yearly'
interface CheckoutResponse { url?: string, error?: string }

const interval: StxSignal<BillingInterval> = state('monthly' as BillingInterval)
const err: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)

function pick(v: BillingInterval): void { interval.set(v) }

async function upgrade(): Promise<void> {
  loading.set(true)
  err.set('')
  try {
    // Same-origin credentialed fetch: the browser sends the HttpOnly auth-token
    // cookie automatically, and the endpoint's auth middleware resolves the user
    // from it. A signed-out visitor gets a 401 here and is sent to /login rather
    // than being pre-checked client-side (no token lives in JS to check).
    const res = await fetch('/payments/checkout', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ interval: interval() }),
    })
    if (res.status === 401) { navigate('/login'); return }
    const data: CheckoutResponse = await res.json().catch(() => ({}))
    // Stripe is a different origin, so this is a real document load, not a routing
    // failure -- { reload: true } is the declared form of exactly that (the legacy
    // positional `true` meant the same at runtime but is not in the type).
    if (res.ok && data.url) { navigate(data.url, { reload: true }); return }
    err.set(data.error || 'Checkout is not available yet.')
  }
  catch {
    err.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('marketing')


{{-- No <style> block, and no @push('styles'): rule 3 / §11.1. Everything the
    block declared is a utility on the element below, spelled against
    public/marketing.css's own tokens (--surface, --ink, --muted, --faint,
    --line, --line-strong, --accent, --r) so the page stays dark-locked and on
    the site's teal, with no token redefinition and no light-mode override.

    Shortcuts were the wrong vehicle here and so was a preflight: these are
    one-offs on a single page, not a repeated composite, and §11.1's answer for
    a one-off is the utility on the element.

    Two shapes are spelled as mutually exclusive class sets rather than a base
    plus an override, because utilities are all unlayered and all of equal
    specificity -- which one wins is source order in the generated sheet, and
    that follows the order the extractor meets them. The billing toggle's
    on/off colours are the two branches of one ternary, and the featured plan
    carries --accent-line in place of --line rather than after it. --}}

@section('content')
      @include('breadcrumbs', { crumbs })

      <section class="feat-hero shell">
        <span class="kicker">Pricing</span>
        <h1>Simple, honest pricing.</h1>
        <p>Start free and upgrade when you outgrow it. Every plan is cookieless and exact, and self-hosting is free forever.</p>
      </section>

      <section class="reveal section shell" aria-label="Plans and pricing">
        <div class="flex justify-center mb-11">
          <div class="inline-flex gap-1 p-[0.28rem] bg-[var(--surface)] border border-[var(--line-strong)] border-solid rounded-[999px]" role="group" aria-label="Billing interval">
            <button @click="pick('monthly')" class="px-[1.15rem] py-2 font-medium text-[0.9rem] rounded-[999px] appearance-none cursor-pointer [border:0] [transition:color_0.16s_ease,background_0.16s_ease]" :class="interval() === 'monthly' ? 'bg-[var(--accent)] text-[var(--accent-ink)]' : 'bg-transparent text-[var(--muted)] hover:text-[var(--ink)]'">Monthly</button>
            <button @click="pick('yearly')" class="px-[1.15rem] py-2 font-medium text-[0.9rem] rounded-[999px] appearance-none cursor-pointer [border:0] [transition:color_0.16s_ease,background_0.16s_ease]" :class="interval() === 'yearly' ? 'bg-[var(--accent)] text-[var(--accent-ink)]' : 'bg-transparent text-[var(--muted)] hover:text-[var(--ink)]'">Yearly <span class="text-[0.78rem] opacity-[0.85]">Save 17%</span></button>
          </div>
        </div>

        <div class="grid gap-5 grid-cols-2 max-sm:grid-cols-1 mx-auto max-w-[720px]">
          <div class="relative p-[1.9rem] bg-[var(--surface)] border border-[var(--line)] border-solid rounded-[var(--r)]">
            <span class="text-[0.74rem] text-[var(--faint)] tracking-[0.14em] uppercase [font-family:var(--mono)]">Free</span>
            <div class="flex gap-[0.3rem] items-baseline mt-4"><span class="font-bold text-[2.4rem] text-[var(--ink)] tracking-[-0.03em]">$0</span><span class="text-[0.9rem] text-[var(--faint)]">/ forever</span></div>
            <p class="mt-[0.55rem] leading-[1.55] text-[0.92rem] text-[var(--muted)]">Everything you need to get started.</p>
            <ul class="grid gap-[0.65rem] mt-6 p-0 list-none">
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 1 site</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 10k events / mo</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 30-day retention</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Community support</li>
            </ul>
            <StxLink to="/register" class="justify-center mt-7 w-full btn ghost">Get started</StxLink>
          </div>

          <div class="relative p-[1.9rem] bg-[var(--surface)] border border-[var(--accent-line)] border-solid rounded-[var(--r)] [box-shadow:0_18px_60px_color-mix(in_srgb,var(--accent)_12%,transparent)]">
            <span class="text-[0.74rem] text-[var(--accent)] tracking-[0.14em] uppercase [font-family:var(--mono)]">Pro</span>
            <div class="flex gap-[0.3rem] items-baseline mt-4">
              <span class="font-bold text-[2.4rem] text-[var(--ink)] tracking-[-0.03em]">{{ interval() === 'yearly' ? '\$190' : '\$19' }}</span>
              <span class="text-[0.9rem] text-[var(--faint)]">{{ interval() === 'yearly' ? '/ year' : '/ month' }}</span>
            </div>
            <p class="mt-[0.55rem] leading-[1.55] text-[0.92rem] text-[var(--muted)]">For teams and sites that are growing.</p>
            <ul class="grid gap-[0.65rem] mt-6 p-0 list-none">
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Unlimited sites</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Unlimited events</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Full retention</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Priority support</li>
              <li class="flex gap-[0.55rem] items-center text-[0.92rem] text-[var(--ink)]"><svg class="flex-none h-4 w-4 text-[var(--accent)]" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Import history from a CSV export</li>
            </ul>
            <button @click="upgrade" :disabled="loading()" class="justify-center mt-7 w-full btn primary">{{ loading() ? 'Redirecting…' : 'Upgrade to Pro' }}</button>
            @if (err())
              <p class="mt-[0.85rem] text-[0.8rem] text-[var(--danger)] text-center">{{ err() }}</p>
            @endif
          </div>
        </div>

        <p class="mt-11 mx-auto text-[0.85rem] text-[var(--faint)] text-center">Prefer to self-host? analyticshq is open source and free to run yourself.</p>
      </section>

      <section class="reveal section shell" aria-label="Get started">
        <div class="cta-band">
          <h2>Your numbers. Your visitors' privacy. Both intact.</h2>
          <div class="cta-actions">
            <StxLink class="btn primary" to="/#install">Get your script tag</StxLink>
            <StxLink class="btn ghost" to="/compare">Compare the alternatives</StxLink>
          </div>
        </div>
      </section>
@endsection
