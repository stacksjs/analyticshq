<script server>
useSeoMeta({
  canonical: 'https://analyticshq.org/pricing',
  title: "Pricing - analyticshq",
  description: "Simple, honest pricing for privacy-first web analytics. Start free with 10k events a month, upgrade to Pro for unlimited sites and events, or self-host for free forever.",
})

// Drives BOTH the JSON-LD below and the visible nav, so the two cannot drift.
const crumbs = [
  { name: "Home", href: "/", url: "https://analyticshq.org/" },
  { name: "Pricing" },
]
</script>

<script client>
// Pricing / upgrade via stx client directives. Interval + state are signals; the
// Upgrade button starts a Stripe Checkout on Stripe's own origin.
type BillingInterval = 'monthly' | 'yearly'
interface CheckoutResponse { url?: string, error?: string }

const session = useStore('session') as SessionStore
const interval: StxSignal<BillingInterval> = state('monthly')
const err: StxSignal<string> = state('')
const loading: StxSignal<boolean> = state(false)

function pick(v: BillingInterval): void { interval.set(v) }

async function upgrade(): Promise<void> {
  if (!session.isAuthed()) { navigate('/login'); return }
  loading.set(true)
  err.set('')
  try {
    const res = await fetch('/payments/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...session.authHeaders() },
      body: JSON.stringify({ interval: interval() }),
    })
    const data: CheckoutResponse = await res.json().catch(() => ({}))
    // Stripe is a different origin, so this is a real document load, not a routing
    // failure -- navigate(url, true) is the declared form of exactly that.
    if (res.ok && data.url) { navigate(data.url, true); return }
    err.set(data.error || 'Checkout is not available yet.')
  }
  catch {
    err.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

@extends('marketing')


@push('styles')
<style>
  /* Pricing-specific pieces, built on the shared marketing.css tokens so the
    page stays dark-locked and on the same teal accent as the rest of the site.
    No token redefinition, no light-mode override. */
  .price-toggle-row { display: flex; justify-content: center; margin-bottom: 2.75rem; }
  .price-toggle { display: inline-flex; gap: 0.25rem; padding: 0.28rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); }
  .price-toggle button { appearance: none; border: 0; cursor: pointer; padding: 0.5rem 1.15rem; border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-weight: 500; font-size: 0.9rem; transition: color 0.16s ease, background 0.16s ease; }
  .price-toggle button:hover { color: var(--ink); }
  .price-toggle button.on { background: var(--accent); color: var(--accent-ink); }
  .price-toggle .save { font-size: 0.78rem; opacity: 0.85; }

  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; max-width: 720px; margin: 0 auto; }
  .plan { position: relative; padding: 1.9rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .plan.featured { border-color: var(--accent-line); box-shadow: 0 18px 60px color-mix(in srgb, var(--accent) 12%, transparent); }
  .plan-eyebrow { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .plan.featured .plan-eyebrow { color: var(--accent); }
  .plan-price { margin: 1rem 0 0; display: flex; align-items: baseline; gap: 0.3rem; }
  .plan-amt { font-size: 2.4rem; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
  .plan-per { color: var(--faint); font-size: 0.9rem; }
  .plan-desc { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
  .plan-list { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 0.65rem; }
  .plan-list li { display: flex; align-items: center; gap: 0.55rem; font-size: 0.92rem; color: var(--ink); }
  .plan-check { width: 16px; height: 16px; flex: none; color: var(--accent); }
  .plan .btn { width: 100%; justify-content: center; margin-top: 1.75rem; }
  .price-err { margin: 0.85rem 0 0; text-align: center; font-size: 0.8rem; color: #f87171; }
  .self-host { margin: 2.75rem auto 0; text-align: center; color: var(--faint); font-size: 0.85rem; }

  @media (max-width: 640px) {
    .plans { grid-template-columns: 1fr; }
  }
</style>
@endpush

@section('content')
      @structuredData({
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
      })

      <nav class="shell subnav" aria-label="Breadcrumb">
        @foreach (crumbs as c)
          @if (c.href)
            <a href="{{ c.href }}"{{ c.noRouter ? ' data-no-router' : '' }}>{{ c.name }}</a><span class="sep" aria-hidden="true">/</span>
          @else
            <span aria-current="page">{{ c.name }}</span>
          @endif
        @endforeach
      </nav>

      <section class="feat-hero shell">
        <span class="kicker">Pricing</span>
        <h1>Simple, honest pricing.</h1>
        <p>Start free and upgrade when you outgrow it. Every plan is cookieless and exact, and self-hosting is free forever.</p>
      </section>

      <section class="reveal section shell" aria-label="Plans and pricing">
        <div class="price-toggle-row">
          <div class="price-toggle" role="group" aria-label="Billing interval">
            <button @click="pick('monthly')" :class="interval() === 'monthly' ? 'on' : ''">Monthly</button>
            <button @click="pick('yearly')" :class="interval() === 'yearly' ? 'on' : ''">Yearly <span class="save">Save 17%</span></button>
          </div>
        </div>

        <div class="plans">
          <div class="plan">
            <span class="plan-eyebrow">Free</span>
            <div class="plan-price"><span class="plan-amt">$0</span><span class="plan-per">/ forever</span></div>
            <p class="plan-desc">Everything you need to get started.</p>
            <ul class="plan-list">
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 1 site</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 10k events / mo</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> 30-day retention</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Community support</li>
            </ul>
            <a href="/register" class="btn ghost">Get started</a>
          </div>

          <div class="featured plan">
            <span class="plan-eyebrow">Pro</span>
            <div class="plan-price">
              <span class="plan-amt">{{ interval() === 'yearly' ? '\$190' : '\$19' }}</span>
              <span class="plan-per">{{ interval() === 'yearly' ? '/ year' : '/ month' }}</span>
            </div>
            <p class="plan-desc">For teams and sites that are growing.</p>
            <ul class="plan-list">
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Unlimited sites</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Unlimited events</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Full retention</li>
              <li><svg class="plan-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 4.5l-7 7-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> Priority support</li>
            </ul>
            <button @click="upgrade" :disabled="loading()" class="btn primary">{{ loading() ? 'Redirecting…' : 'Upgrade to Pro' }}</button>
            @if (err())
              <p class="price-err">{{ err() }}</p>
            @endif
          </div>
        </div>

        <p class="self-host">Prefer to self-host? analyticshq is open source and free to run yourself.</p>
      </section>

      <section class="reveal section shell" aria-label="Get started">
        <div class="cta-band">
          <h2>Your numbers. Your visitors' privacy. Both intact.</h2>
          <div class="cta-actions">
            <a class="btn primary" href="/#install">Get your script tag</a>
            <a class="btn ghost" href="/compare" data-no-router>Compare the alternatives</a>
          </div>
        </div>
      </section>
@endsection
