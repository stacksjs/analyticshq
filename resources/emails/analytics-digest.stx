<script server>
// A DOCTYPE and <html> are correct HERE and nowhere else in this repo. stx-standards
// §3.1 forbids them in pages and components because they suppress the generated
// document shell; an email is not served by stx, has no layout, and every client
// expects a complete document. Same reason the styles are inline: Gmail strips
// <style> blocks, so a shared stylesheet would silently unstyle the whole message.
const appName = props.appName || 'analyticshq'
const siteName = props.siteName || 'your site'
const dashboardUrl = props.dashboardUrl || '#'
const settingsUrl = props.settingsUrl || '#'
const periodLabel = props.periodLabel || 'Last week'
const rangeLabel = props.rangeLabel || ''
const visitors = props.visitors || '0'
const views = props.views || '0'
const sessions = props.sessions || '0'
// Pre-formatted by the sender ("+12%", "-4%", or "" when there is no baseline).
// Deltas are computed in app/Analytics/summary.ts and rendered as strings so the
// template never has to decide what "no previous period" looks like.
const visitorsDelta = props.visitorsDelta || ''
const viewsDelta = props.viewsDelta || ''
const topPages = props.topPages || []
const topSources = props.topSources || []
const year = props.year || new Date().getFullYear()
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ periodLabel }} on {{ siteName }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #0e0e0e; line-height: 1.6; color: #d4d4d4;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">

          <tr>
            <td style="text-align: center; padding-bottom: 32px;">
              <h1 style="color: #ececec; font-size: 28px; font-weight: 600; margin: 0;">{{ appName }}</h1>
            </td>
          </tr>

          <tr>
            <td style="background-color: #1a1a1a; border-radius: 12px; padding: 40px;">

              <h2 style="color: #ececec; font-size: 22px; font-weight: 600; margin: 0 0 4px;">{{ periodLabel }} on {{ siteName }}</h2>
              <p style="color: #6d777c; font-size: 13px; margin: 0 0 28px;">{{ rangeLabel }}</p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 28px;">
                <tr>
                  <td style="padding: 0 8px 0 0; vertical-align: top;">
                    <div style="color: #6d777c; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;">Visitors</div>
                    <div style="color: #ececec; font-size: 26px; font-weight: 700;">{{ visitors }}</div>
                    <div style="color: #6d777c; font-size: 12px;">{{ visitorsDelta }}</div>
                  </td>
                  <td style="padding: 0 8px; vertical-align: top;">
                    <div style="color: #6d777c; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;">Page views</div>
                    <div style="color: #ececec; font-size: 26px; font-weight: 700;">{{ views }}</div>
                    <div style="color: #6d777c; font-size: 12px;">{{ viewsDelta }}</div>
                  </td>
                  <td style="padding: 0 0 0 8px; vertical-align: top;">
                    <div style="color: #6d777c; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;">Sessions</div>
                    <div style="color: #ececec; font-size: 26px; font-weight: 700;">{{ sessions }}</div>
                  </td>
                </tr>
              </table>

              @if (topPages.length)
                <h3 style="color: #ececec; font-size: 14px; font-weight: 600; margin: 0 0 10px;">Top pages</h3>
                <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                  @foreach (topPages as row)
                    <tr>
                      <td style="color: #a0a0a0; font-size: 14px; padding: 6px 0; border-top: 1px solid #262626;">{{ row.label }}</td>
                      <td style="color: #ececec; font-size: 14px; padding: 6px 0; border-top: 1px solid #262626; text-align: right;">{{ row.views }}</td>
                    </tr>
                  @endforeach
                </table>
              @endif

              @if (topSources.length)
                <h3 style="color: #ececec; font-size: 14px; font-weight: 600; margin: 0 0 10px;">Top sources</h3>
                <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 28px;">
                  @foreach (topSources as row)
                    <tr>
                      <td style="color: #a0a0a0; font-size: 14px; padding: 6px 0; border-top: 1px solid #262626;">{{ row.label }}</td>
                      <td style="color: #ececec; font-size: 14px; padding: 6px 0; border-top: 1px solid #262626; text-align: right;">{{ row.views }}</td>
                    </tr>
                  @endforeach
                </table>
              @endif

              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color: #46d3c0; border-radius: 8px;">
                    <a href="{{ dashboardUrl }}" style="display: inline-block; padding: 12px 22px; color: #04201c; font-size: 15px; font-weight: 600; text-decoration: none;">Open dashboard</a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <tr>
            <td style="text-align: center; padding-top: 24px;">
              <p style="color: #6d777c; font-size: 12px; margin: 0 0 6px;">
                You are getting this because digests are switched on for {{ siteName }}.
                <a href="{{ settingsUrl }}" style="color: #46d3c0; text-decoration: none;">Turn them off</a>.
              </p>
              <p style="color: #4a4a4a; font-size: 12px; margin: 0;">&copy; {{ year }} {{ appName }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
