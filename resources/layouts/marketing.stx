{{-- Marketing chrome. Layout group 'marketing'.

    This file is a FRAGMENT, not a document. stx synthesises <!DOCTYPE>, <html lang>,
    <head> and <body> from config/ui.ts app.head merged with each page's head — see
    generateDocumentShell. Writing a DOCTYPE or an html tag here (even inside a
    comment, because the test is an unanchored regex over the rendered string) makes
    hasDocumentShell() true, turns ensureDocumentShell into a no-op, and every page's
    title/description is dropped on the floor. Never add one.

    Comment with stx's own delimiters rather than an HTML comment: those are removed
    before any gate runs, while an HTML comment survives into the response and is
    re-parsed by four separate consumers downstream.

    Never write stx's closing delimiter inside a comment body -- not even as an
    example of the syntax, which is exactly how this block shipped broken to
    production. The stripper is non-nesting: it cuts from the opening delimiter to
    the FIRST closing one, so an inner example terminates the comment early and
    every line after it renders as visible text at the top of the page.

    The name of this file IS the router's layout group: crossing between 'marketing'
    and the app shell makes the router do a full-document swap, which is the only
    path that carries stylesheet links across a navigation. --}}

<script server>
// Who is signed in, for the nav's @auth / @guest directives, which read
// `auth.check` and `auth.user` from the render context. Nothing fills that in
// on its own, so the layout does it once for every marketing page, through the
// shared helper (app/Support/session.ts). These pages render per request
// (Cache-Control: no-store), so one reader's nav is never served to another.
import { sessionFrom } from '../../app/Support/session'

const auth = await sessionFrom(typeof cookies !== 'undefined' ? cookies : {})
</script>

@head
{{-- Marketing-only. Deliberately NOT in config/ui.ts app.head, which is global and
    would push these onto the 5 app/auth pages that intentionally do without them. --}}
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0c0e">
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafbfb">
{{-- /marketing.css is gone: it is the MARKETING preflight in
    config/crosswind.ts, scoped to this layout's group
    (stx-standards rule 3, §11.2). --}}
@endhead

{{-- The coming-soon gate. Lived in index.stx until now, which is why that page had to
    write its own document shell -- body tag, doctype and all -- and so could not use
    this layout. The three data-* attributes it keys off are supplied to every page by
    config/ui.ts app.head.bodyAttrs; the four rules that act on them are in
    public/marketing.css, and resources/assets/scripts/site-mode.js handles the
    ?preview=<token> bypass.

    Moving it here also closes the hole it had: only / was ever gated, so every other
    marketing page stayed fully readable while the homepage said "almost ready".
    Dormant at data-site-mode="live" -- both halves are display:none'd by default. --}}
<section class="mode-screen" aria-labelledby="coming-soon-heading">
  <div class="mode-card">
    <h1 id="coming-soon-heading">analyticshq</h1>
    <p>Privacy-first web analytics is almost ready. Leave your email and we will send the install snippet the moment it opens.</p>
    <form class="flex flex-wrap gap-[0.6rem] mt-[1.25rem] max-w-[30rem]" action="/api/email/subscribe" method="POST">
      <input class="px-[0.9rem] py-0 min-h-[46px] text-[var(--ink)] bg-[var(--surface-2)] border border-[var(--line-strong)] rounded-[var(--r-sm)] [flex:1_1_15rem] [font:inherit]" type="email" name="email" placeholder="you@example.com" autocomplete="email" aria-label="Email address" required>
      <button class="btn primary" type="submit">Notify me</button>
    </form>
  </div>
</section>

{{-- .site-content is the element marketing.css hides when the gate is armed, so it
    must wrap all three pieces of chrome -- nav, main and footer -- exactly as it did
    in index.stx. --}}
<div class="site-content">
  <SiteNav :auth="auth" />

  {{-- The single router container. Pages must NOT declare their own <main>: fragment
      extraction slices from the first <main> to the LAST </main>, so a second one
      makes the router swap the wrong span and duplicate the chrome. --}}
  <main>
{{-- Inside the container, not in @head. A pushed <style> in the head is never
    removed -- the router only manages style[data-crosswind] and
    style[data-stx-page] -- so whichever page the visitor entered on kept its
    rules applied to every route for the rest of the session. Here the block is
    part of the swapped fragment and lives exactly as long as the page does. --}}
@stack('styles')
@yield('content')
  </main>

  @include('site-footer')
</div>

<script src="/assets/scripts/site-mode.js" defer></script>

{{-- BreadcrumbList JSON-LD for any page that defines `crumbs`, from the same array
    that renders the visible nav via @include('breadcrumbs') — so the two cannot
    drift, which is what the per-page copies were for.

    It lives in the layout rather than in the breadcrumbs partial because @push
    from inside an @include never reaches this @stack: the script tag is silently
    dropped. Verified by diffing the rendered page, not assumed. --}}
@if (typeof crumbs !== 'undefined' && crumbs)
      @structuredData({
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, name: crumb.name, item: crumb.url })),
      })
@endif

@stack('scripts')
