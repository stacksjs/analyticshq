{
  "name": "analyticshq",
  "type": "module",
  "version": "0.70.56",
  "private": true,
  "description": "Your project description",
  "author": "your-name <your-email>",
  "contributors": [
    "Chris Breuer <chris@stacksjs.org>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules pantry.lock && pantry install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "bun scripts/dev.ts",
    "development": "bun scripts/dev.ts",
    "dev:api": "./buddy dev:api",
    "dev:full": "./buddy dev",
    "build": "./buddy build",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "export:site": "bun scripts/analytics/export-site.ts",
    "import:site": "bun scripts/analytics/import-site.ts",
    "import:fathom": "bun scripts/analytics/import-fathom.ts",
    "import:ga": "bun scripts/analytics/import-ga.ts",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun x tsc --noEmit",
    "types:check": "bun tsc --noEmit",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "stx": "./buddy",
    "vendor:map": "bun build node_modules/ts-maps/dist/index.js --outfile public/vendor/ts-maps.js --minify --target browser --format esm && cp node_modules/ts-maps/src/core-map/ts-maps.css public/vendor/ts-maps.css && shasum -a 256 node_modules/ts-maps/dist/index.js | cut -d' ' -f1 > public/vendor/ts-maps.source-sha256",
    "account": "bun scripts/account.ts",
    "account:list": "bun scripts/account.ts --list",
    "account:rotate": "bun scripts/account.ts --rotate"
  },
  "system": {
    "bun": "^1.3.0",
    "sqlite": "^3.47.2"
  },
  "dependencies": {
    "@bughq/stacks": "^0.2.2",
    "@loghq/stacks": "^0.2.6",
    "@stacksjs/buddy": "^0.74.24",
    "@stacksjs/logging": "^0.74.24",
    "@stacksjs/stx": "^0.2.274",
    "@stacksjs/ts-cloud": "^0.12.12",
    "@ts-analytics/tracking": "^0.1.15",
    "mmdb-lib": "^3.0.3",
    "stacks": "^0.74.24",
    "ts-maps": "^0.3.6"
  },
  "devDependencies": {
    "better-dx": "^0.2.25"
  },
  "overrides": {
    "bun-query-builder": "^0.1.44"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit .git/COMMIT_EDITMSG"
  }
}
